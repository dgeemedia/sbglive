# ── Sanity ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_here

# ── Flutterwave ──────────────────────────────────────────
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx
# Set this exact string as your "Secret Hash" in the Flutterwave dashboard
# (Settings → Webhooks). It is used to verify incoming webhook calls.
FLUTTERWAVE_SECRET_HASH=your_own_random_secret_string

# ── Resend (email) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=orders@yourdomain.com

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
