# ── Sanity ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_sanity_api_token_here

# ── Flutterwave ──────────────────────────────────────────
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxx
# Set this exact string as your "Secret Hash" in the Flutterwave dashboard
# (Settings → Webhooks). It is used to verify incoming webhook calls.
FLUTTERWAVE_SECRET_HASH=your_own_random_secret_string
# The CLIENT's Flutterwave subaccount id (starts with RS_). Every payment is split to it, so the
# client is paid directly. Checkout refuses to run without it. Test-mode and live-mode
# subaccounts have DIFFERENT ids — use the one that matches the keys above.
FLUTTERWAVE_SUBACCOUNT_ID=RS_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPTIONAL. Only if ANOTHER app shares this Flutterwave account: a Flutterwave account has a single
# webhook URL, so point that URL at this site and put the other app's webhook URL here. Payments
# that don't belong to this store (references not starting "sbg_") are passed on to it untouched.
# WEBHOOK_FORWARD_URL=https://your-other-app.com/api/webhook

# ── Resend (email) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=orders@sbgfashion.live

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://sbgfashion.live

# OPTIONAL. The verification token Google Search Console gives you ("HTML tag" method, just the content="…" part).
# Not needed if you verify the domain through DNS instead.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
